<%- include('partials/head') %>

<header class="site-header site-header--compact">
  <div class="wrap">
    <a class="back" href="/">← К каталогу</a>
    <h1><%= item.title %></h1>
  </div>
</header>

<main class="wrap">
  <picture>
    <source type="image/avif" srcset="<%= imageUrl(item.image, 'detail', 'avif') %>" />
    <source type="image/webp" srcset="<%= imageUrl(item.image, 'detail', 'webp') %>" />
    <img
      class="item-page__img"
      src="<%= imageUrl(item.image, 'detail', 'jpg') %>"
      alt="<%= item.title %>"
    />
  </picture>
  <p class="item-page__summary"><%= item.summary %></p>
</main>

<%- include('partials/foot') %>
