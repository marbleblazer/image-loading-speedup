<%- include('partials/head') %>

<header class="site-header site-header--compact">
  <div class="wrap">
    <a class="back" href="/">← К каталогу</a>
    <h1><%= item.title %></h1>
  </div>
</header>

<main class="wrap">
  <picture>
    <source
      type="image/avif"
      srcset="<%= imageSrcset(item.image, 'avif') %>"
      sizes="(max-width: 1132px) calc(100vw - 2rem), 1100px"
    />
    <source
      type="image/webp"
      srcset="<%= imageSrcset(item.image, 'webp') %>"
      sizes="(max-width: 1132px) calc(100vw - 2rem), 1100px"
    />
    <img
      class="item-page__img"
      width="1600"
      height="1200"
      fetchpriority="high"
      srcset="<%= imageSrcset(item.image, 'jpg') %>"
      src="<%= imageUrl(item.image, 'detail', 'jpg') %>"
      sizes="(max-width: 1132px) calc(100vw - 2rem), 1100px"
      alt="<%= item.title %>"
    />
  </picture>
  <p class="item-page__summary"><%= item.summary %></p>
</main>

<%- include('partials/foot') %>
