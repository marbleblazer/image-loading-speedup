<%- include('partials/head') %>

<header class="site-header">
  <div class="wrap">
    <h1>Мини-каталог</h1>
  </div>
</header>

<main class="wrap">
  <section class="hero">
    <h2 class="visually-hidden">Главный баннер</h2>
    <picture>
      <source
        type="image/avif"
        srcset="<%= imageSrcset(heroImage, 'avif') %>"
        sizes="(max-width: 1132px) calc(100vw - 2rem), 1100px"
      />
      <source
        type="image/webp"
        srcset="<%= imageSrcset(heroImage, 'webp') %>"
        sizes="(max-width: 1132px) calc(100vw - 2rem), 1100px"
      />
      <img
        class="hero__img"
        width="1600"
        height="1200"
        fetchpriority="high"
        srcset="<%= imageSrcset(heroImage, 'jpg') %>"
        src="<%= imageUrl(heroImage, 'hero', 'jpg') %>"
        sizes="(max-width: 1132px) calc(100vw - 2rem), 1100px"
        alt="Товар в каталоге"
      />
    </picture>
  </section>

  <section class="grid" aria-label="Товары">
    <% items.forEach(function (item, index) { %>
      <article class="card">
        <a class="card__link" href="/item/<%= item.id %>">
          <picture>
            <source
              type="image/avif"
              srcset="<%= imageSrcset(item.image, 'avif') %>"
              sizes="(max-width: 700px) calc(100vw - 2rem), (max-width: 1100px) 50vw, 33vw"
            />
            <source
              type="image/webp"
              srcset="<%= imageSrcset(item.image, 'webp') %>"
              sizes="(max-width: 700px) calc(100vw - 2rem), (max-width: 1100px) 50vw, 33vw"
            />
            <img
              class="card__img"
              width="400"
              height="300"
              <% if (index > 0) { %>loading="lazy"<% } %>
              srcset="<%= imageSrcset(item.image, 'jpg') %>"
              src="<%= imageUrl(item.image, 'card', 'jpg') %>"
              sizes="(max-width: 700px) calc(100vw - 2rem), (max-width: 1100px) 50vw, 33vw"
              alt=""
            />
          </picture>
          <h2 class="card__title"><%= item.title %></h2>
          <p class="card__summary"><%= item.summary %></p>
        </a>
      </article>
    <% }); %>
  </section>
</main>

<%- include('partials/foot') %>
